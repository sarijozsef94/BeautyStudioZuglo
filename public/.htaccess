<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Átirányítások az eredeti WordPress linkekről az új aloldalakra
  RewriteRule ^adatkezelesi-tajekoztato/?$ /adatvedelem/ [R=301,L]
  RewriteRule ^rolunk-cloned-239/?$ /arlista/ [R=301,L]
  RewriteRule ^kapcsolat-2/?$ /kapcsolat/ [R=301,L]
  RewriteRule ^rolunk-2/?$ /rolunk/ [R=301,L]

  # HTTPS kényszerítése (opcionális, ha a tárhely nem kezeli automatikusan)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Ha a kért fájl vagy könyvtár létezik, közvetlen kiszolgálás
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 404 hibaoldal kezelése
  ErrorDocument 404 /404.html
</IfModule>

# GZIP tömörítés bekapcsolása a gyors betöltésért
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Képek és statikus fájlok gyorsítótárazása (Browser Caching)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
